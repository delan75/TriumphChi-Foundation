APP_NAME=TriumphChi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=triumphchi
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
PRIVATE_UPLOAD_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
AUTH_TOKEN_EXPIRATION_DAYS=30
AUTH_ROTATE_TOKENS_ON_LOGIN=true
OAUTH_LOGIN_CODE_EXPIRATION_MINUTES=5
AUTH_EMAIL_VERIFICATION_EXPIRE_MINUTES=60
AUTH_VERIFICATION_OTP_EXPIRATION_MINUTES=10
AUTH_VERIFICATION_OTP_MAX_ATTEMPTS=5
AUTH_OTP_SMS_WEBHOOK_URL=
AUTH_OTP_WHATSAPP_WEBHOOK_URL=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@triumphchi.org
MAIL_FROM_NAME="${APP_NAME}"

SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@triumphchi.org
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_LOCALE=en

# Google OAuth (Laravel Socialite)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {APP_URL}/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (Laravel Socialite)
# Authorised redirect URI: {APP_URL}/api/v1/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# MTN MoMo Collections
# Never commit real credentials. Use separate credentials for sandbox/staging/production.
# Default public configuration restricts MoMo giving to Cameroon and XAF.
# Some sandbox credentials are country-specific; only change country/currency values for local sandbox diagnostics.
MOMO_COLLECTIONS_ENABLED=false
MOMO_COLLECTIONS_ENVIRONMENT=sandbox
MOMO_COLLECTIONS_TARGET_ENVIRONMENT=sandbox
MOMO_COLLECTIONS_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_COLLECTIONS_COUNTRY_CODES=CM
MOMO_COLLECTIONS_CURRENCIES=XAF
MOMO_COLLECTIONS_COUNTRY_CURRENCY_MAP=CM:XAF
MOMO_COLLECTIONS_SUBSCRIPTION_KEY=
MOMO_COLLECTIONS_API_USER=
MOMO_COLLECTIONS_API_KEY=
MOMO_COLLECTIONS_CALLBACK_BASE_URL="${APP_URL}"
MOMO_COLLECTIONS_CALLBACK_SECRET=
MOMO_COLLECTIONS_CALLBACK_ALLOWED_IPS=
MOMO_COLLECTIONS_TIMEOUT_SECONDS=15
MOMO_COLLECTIONS_TOKEN_CACHE_SECONDS=3300
MOMO_COLLECTIONS_RUN_LIVE_TESTS=false
MOMO_COLLECTIONS_LIVE_TEST_MSISDN=
MOMO_COLLECTIONS_LIVE_TEST_AMOUNT=100
MOMO_COLLECTIONS_LIVE_TEST_CURRENCY=XAF

# PayPal Donations
# Never expose PAYPAL_CLIENT_SECRET to React or Vite.
# Sandbox base URL: https://api-m.sandbox.paypal.com
# Production base URL: https://api-m.paypal.com
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_VERIFY_WEBHOOKS=true
PAYPAL_TIMEOUT_SECONDS=15
PAYPAL_TOKEN_CACHE_SECONDS=3300
