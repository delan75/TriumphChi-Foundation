{
  "name": "chisolution/triumphchi-api",
  "description": "Laravel API for an NGO education sponsorship and beneficiary management platform.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.72.0",
    "laravel/sanctum": "^4.0",
    "spatie/laravel-permission": "^6.25",
    "laravel/socialite": "^5.28",
    "spatie/laravel-pdf": "^2.12",
    "spatie/browsershot": "^5.4"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.18",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^11.0",
    "nunomaduro/collision": "^8.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php artisan test",
    "lint": "vendor/bin/pint"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
